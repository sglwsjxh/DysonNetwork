# ===========================================
# DysonNetwork Production Environment Template
# ===========================================
# Copy this file to .env and fill in your values
# WARNING: Never commit .env files to version control!

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- NATS ---
NATS_PASSWORD=CHANGE_ME_NATS_PASSWORD

# --- Gateway URLs ---
SITE_URL=https://akiromusic.art
ISSUER_URI=https://id.akiromusic.art
API_URL=https://api.akiromusic.art

# --- Database Connection Strings (template) ---
# ConnectionStrings__App__Host=postgres
# ConnectionStrings__App__Port=5432
# ConnectionStrings__App__Username=postgres
# ConnectionStrings__App__Password=${POSTGRES_PASSWORD}

# --- Cloudflare Tunnel ---
# Get your tunnel token from Cloudflare Zero Trust dashboard
TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN

# --- LiveKit (optional, for voice/video calls) ---
# LIVEKIT_ENDPOINT=wss://your-livekit-server.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Image Tags ---
# Set to your GHCR registry
IMAGE_TAG=latest
REGISTRY=ghcr.io/sglwsjxh
